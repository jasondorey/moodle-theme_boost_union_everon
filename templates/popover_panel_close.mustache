{{!
    @template theme_boost_union_everon/popover_panel_close

    Top-right panel close control matching Moodle notifications
    (message_popup/notification_popover: i/window_close + closebuttontitle).
}}
<button
    type="button"
    class="btn btn-sm btn-link m-0 py-0 icon-no-margin everon-popover-close"
    data-action="everon-popover-close"
    aria-label="{{#str}} closebuttontitle {{/str}}"
    title="{{#str}} closebuttontitle {{/str}}"
>
    {{#pix}} i/window_close, core {{/pix}}
</button>
