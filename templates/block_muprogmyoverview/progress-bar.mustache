{{!
    @template block_muprogmyoverview/progress-bar

    Everon override: circular progress tracker matching course cards.
    On card view, MuTMS CSS overlays this on the program image (bottom-right).
    Ring fill uses --everon-progress (0–100) via conic-gradient.
    Status badges (e.g. Open) stay in the card body — not replaced here.

    Example context (json):
    {
        "progress": 50
    }
}}
<div class="theme-boost-union-everon-mycourses-progress" style="--everon-progress: {{progress}};">
    <div class="progress-text visually-hidden">
        <span class="visually-hidden">{{#str}}aria:programprogress, block_muprogmyoverview{{/str}}</span>
        {{#str}}completepercent, block_muprogmyoverview, <span>{{progress}}</span>{{/str}}
    </div>
    <div
        class="theme-boost-union-everon-mycourses-progress__circle"
        role="progressbar"
        aria-valuenow="{{progress}}"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-label="{{#str}}aria:programprogress, block_muprogmyoverview{{/str}}"
    >
        <span class="theme-boost-union-everon-mycourses-progress__value" aria-hidden="true">{{progress}}%</span>
    </div>
</div>
